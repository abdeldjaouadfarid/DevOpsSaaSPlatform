
NODE_ENV=development
PORT=3000

# Postgres (matches infra/docker-compose.dev.yml defaults)
DATABASE_URL=postgresql://devops:devops@localhost:5434/devops_saas?schema=public

# JWT — replace with 32+ random bytes in real deployments
JWT_SECRET=change-to-32-orplus-byte-random-
JWT_EXPIRES_IN=1h

# CORS origin for the future dashboard
CORS_ORIGIN=http://localhost:5173

# Redis (matches infra/docker-compose.dev.yml defaults)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# Optional: force Swagger UI / Bull Board on outside dev
# SWAGGER_ENABLED=true
# BULL_BOARD_ENABLED=true
